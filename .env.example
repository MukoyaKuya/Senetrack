# Copy to .env and fill in real values. Never commit .env.

# --- Required in production ---
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=postgresql://user:password@host:5432/neondb?sslmode=require

# Cloudinary (media in production)
USE_CLOUDINARY=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# HTTP-only EC2 IP deploy (set true later when you add HTTPS)
SECURE_SSL_REDIRECT=false

# --- Recommended on free VMs ---
# Oracle Ampere: GUNICORN_WORKERS=2 is fine (more RAM).
# AWS micro (~1 GB): use GUNICORN_WORKERS=1.
PORT=8080
GUNICORN_WORKERS=2
# SKIP_SYNC_PERFORMANCE=true

# --- Optional ---
# DJANGO_ADMIN_PATH=manage-senetrack
# MAPBOX_ACCESS_TOKEN=
# PLAUSIBLE_DOMAIN=
# REDIS_URL=
# USE_REMOTE_DB=true
